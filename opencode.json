{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "brand/voice.md",
    ".opencode/rules/emails.md"
  ],
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": ".opencode/rules/*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": ".opencode/plugins/*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "opencode.json",
      "effect": "ask"
    }
  ],
  "mcp": {
    "servers": {
      "resend": {
        "type": "local",
        "command": [
          "node",
          "scripts/resend-mcp.mjs"
        ],
        "codemode": false
      }
    }
  }
}
